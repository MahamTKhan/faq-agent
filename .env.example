# ── Required ────────────────────────────────────────────────
# Postgres connection string (Supabase, Neon or Vercel Postgres).
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
DATABASE_URL=postgresql://neondb_owner:npg_YosLcv2xVh6J@ep-blue-wave-b5fp1vcq-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require 
#postgresql://user:password@host:6543/postgres

The password you use to log in to /admin.
ADMIN_PASSWORD=ADMIN_PASSWORD

# Random string, at least 32 characters, used to sign your login cookie.
# Generate one: openssl rand -hex 32
SESSION_SECRET=abcdefghijklmnoppqrstuvwxyz

# From console.anthropic.com → API keys.
ANTHROPIC_API_KEY= 

# Where new-question alerts go (your inbox).
ADMIN_EMAIL=maham.khan@azimutlabs.com

# ── Email sending (SMTP) ────────────────────────────────────
# Without these the app still works, but no emails are sent.
# Gmail: host smtp.gmail.com, port 465, user = your Gmail, pass = an App Password.
# Outlook / Microsoft 365: host smtp.office365.com, port 587.
# Resend: host smtp.resend.com, port 465, user "resend", pass = your Resend API key.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The "From" line, e.g.  Project Desk <you@example.com>
MAIL_FROM=

# ── Optional ────────────────────────────────────────────────
# Public URL of the app, used for links in emails. Defaults to the request's own URL.
APP_URL=
# Name shown in the header and emails.
APP_NAME=Project Desk
# Model used for answers and for reading PDFs.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Knowledge bases smaller than this (characters) are sent to the model in full;
# larger ones are searched and only the best-matching passages are sent.
MAX_CONTEXT_CHARS=400000
